; Engine configuration file.
; Aurora City is a Godot 4 Android-first open-world prototype.
config_version=5

[application]
config/name="Aurora City"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.043, 0.075, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.043, 0.075, 1)

[physics]
3d/default_gravity=24.0

[mobile]
driver/driver_name="opengl3"
